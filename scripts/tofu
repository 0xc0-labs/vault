#!/usr/bin/env bash
# Over WARP, logged in to Vault, whose token the vault provider uses too. The
# state's credentials stay in the environment, never on disk.
set -euo pipefail
cd "$(dirname "$0")/.."

env="${1:?usage: scripts/tofu <environment> <tofu args...>}"
shift
[ -d "environments/$env" ] || { echo "no such environment: environments/$env" >&2; exit 1; }

export VAULT_ADDR="${VAULT_ADDR:-https://vault.int.0xc0.cc}"
vault token lookup >/dev/null || { echo "not logged in to Vault: vault login -no-print" >&2; exit 1; }

AWS_ACCESS_KEY_ID="$(vault kv get -mount=ci -field=access_key_id shared/rustfs)"
AWS_SECRET_ACCESS_KEY="$(vault kv get -mount=ci -field=secret_access_key shared/rustfs)"
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY

# Wait for CI to release the state lock rather than failing straight away.
export TF_CLI_ARGS_plan="${TF_CLI_ARGS_plan:--lock-timeout=5m}"
export TF_CLI_ARGS_apply="${TF_CLI_ARGS_apply:--lock-timeout=5m}"

exec tofu -chdir="environments/$env" "$@"
